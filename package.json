{
  "name": "motiqo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3014",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3014",
    "typecheck": "tsc --noEmit",
    "previews:videos": "node scripts/capture-preview-videos.cjs",
    "previews:build": "node scripts/build-preview-posters.mjs",
    "test:loader": "node --test tests/brand-loader.test.cjs",
    "test:interface": "node --test tests/chimes.test.cjs",
    "quality:check": "node scripts/check-component-quality.mjs",
    "publication:check": "node scripts/check-public-files.mjs",
    "test:component": "node scripts/check-component-quality.mjs",
    "distribution:build": "node scripts/build-distribution.mjs",
    "distribution:pack": "node scripts/build-distribution.mjs --pack",
    "prebuild": "npm run distribution:pack",
    "test": "node --test tests/*.test.cjs",
    "verify:exports": "node scripts/verify-exports.mjs",
    "verify:consumer": "node scripts/verify-consumer.mjs",
    "verify:http": "node scripts/verify-http.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "pretest": "npm run distribution:build",
    "preverify:exports": "npm run distribution:pack",
    "predev": "npm run distribution:pack",
    "readme:build": "node scripts/build-readme.mjs",
    "readme:gifs": "node scripts/build-readme-gifs.mjs",
    "assets:sync": "node scripts/sync-image-assets.mjs",
    "predistribution:build": "npm run assets:sync",
    "predistribution:pack": "npm run assets:sync"
  },
  "dependencies": {
    "@fontsource-variable/merriweather-sans": "^5.3.0",
    "@fontsource-variable/urbanist": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.63.0",
    "motion": "^12.42.2",
    "next": "16.3.8",
    "prettier": "^3.9.10",
    "prism-react-renderer": "^2.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.172.0",
    "autoprefixer": "^10.6.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.32",
    "sharp": "0.35.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^7",
    "typescript-compiler-api": "npm:typescript@5.9.3",
    "zod": "^4.6.7"
  },
