{
  "name": "motiqo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3014",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3014",
    "typecheck": "tsc --noEmit",
    "previews:build": "node scripts/build-preview-posters.mjs",
    "test:loader": "node --test tests/brand-loader.test.cjs",
    "test:interface": "node --test tests/silk-aperture.test.cjs",
    "distribution:build": "node scripts/build-distribution.mjs",
    "distribution:pack": "node scripts/build-distribution.mjs --pack",
    "prebuild": "npm run distribution:pack",
    "test": "node --test tests/*.test.cjs",
    "verify:exports": "node scripts/verify-exports.mjs",
    "pretest": "npm run distribution:build",
    "preverify:exports": "npm run distribution:pack",
    "predev": "npm run distribution:pack",
    "readme:build": "node scripts/build-readme.mjs",
    "readme:gifs": "node scripts/build-readme-gifs.mjs",
    "assets:sync": "node scripts/sync-image-assets.mjs",
    "predistribution:build": "npm run assets:sync",
    "predistribution:pack": "npm run assets:sync",
    "publication:check": "node scripts/check-public-files.mjs"
  },
  "dependencies": {
    "@fontsource-variable/merriweather-sans": "^5.3.0",
    "@fontsource-variable/urbanist": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.27.0",
    "motion": "^12.42.2",
    "next": "16.3.8",
    "prettier": "^3.9.10",
    "prism-react-renderer": "^2.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.172.0",
    "jsdom": "^29.1.1",
    "typescript": "^5"
  },
  "license": "MIT"
}
